PORT=3333
# chave que assina os logins; em produção use uma frase longa e aleatória
JWT_SECRET=troque-esta-chave

# ── Supabase ──
# Banco: Connect → Session pooler (troque [YOUR-PASSWORD] pela senha do banco).
# Sem DATABASE_URL a API usa um Postgres embutido (PGlite), que some ao fechar.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Storage dos prints: Project URL e a chave secret (Project Settings → API Keys).
# Sem essas duas, os prints ficam na pasta uploads/.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_BUCKET=evidencias

# mostra o código de recuperação de senha na tela (o projeto não envia e-mail)
MODO_DEMO=1
